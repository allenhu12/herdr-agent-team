# Lead-Agent-owned. Atomic replacement on every transition.
schema_version: 2
updated_at: null
project_root: "/absolute/canonical/project"
team_dir: "/absolute/canonical/project/.herdr-agent-team"  # must equal team.yaml team_dir
lead:
  name: "<task>-lead-<model-label>"
  launched_by_team: false # true when a Launcher spawned this Lead
  handoff_at: null        # set when ownership passed to this Lead
  pane_id: null
  kind: null
  cwd: null
  process_identity: null # {agent_session_id: ...} or {pid: ..., started_at: ...}
  identity_verified_at: null
  model: null # Observed if available; never inferred from a name.
  effort: null
lead_history: []
launcher: null
# launcher: {name, pane_id, kind, process_identity, handoff_at}; writes nothing after handoff_at.
roles: {}
# roles:
#   login-api-codex:
#     pane_id: "w1:p2"
#     kind: codex
#     cwd: "/absolute/exclusive/writer/checkout"
#     checkout_identity: {root: "/absolute/exclusive/writer/checkout", git_dir: "/absolute/git/worktrees/api"}
#     created_by_team: true
#     process_identity: {agent_session_id: "observed-session-id"}
#     model: "explicit-model-id"
#     profile: null
#     effort: high
#     launch_verification:
#       verified_at: "2026-09-05T10:00:00Z"
#       process_identity: {agent_session_id: "observed-session-id"}
#       name: login-api-codex
#       model: "observed-model-id"
#       effort: high
#       evidence_path: "/absolute/header-evidence"
#     expected_agent_state: idle
#     role_history: []   # prior names after an Adjust rename: [{name, until, reason}]
#     rotations: []      # [{at, reason, handoff_path}] for live Assignment rotations
assignments: []
# Each: id, attempt, assignee, assignment_status, created_at, finished_at,
# base_commit or input_snapshot, checkout_dir, report_path, artifact, lease.
# Code work also records:
#   repositories: [{name: backend, input_sha: "<sha>", result_sha: null}]
#   dirty_baseline: "<team_dir>/assignments/<id>/artifacts/attempt-<n>/dirty-baseline.tsv" or null
#   dirty_at_dispatch: [{repo: backend, path: src/app.js, snapshot: "<workspace>/artifacts/attempt-<n>/snapshots/backend/src/app.js"}]
#   commit: {status: none, confirmed_files: [], approved_by: null, approved_at: null}
# Pending records may be queued with dispatched_at: null; never overwrite an active item.
commit_approval:        # shared mode only; see acceptance.md "Commit gate"
  mode: ask             # ask | auto; only the User's own words set auto
  granted_by_words: null
  granted_at: null
commit_log: []
# Each: assignment_id, repository, sha, files, approved_by (user | auto), at.
monitors: []
# Each: assignment_id, attempt, assignee, task_handle (host handle, not shell PID),
#       optional outcome (report | handoff | blocked | unknown | gone | stalled | no_report | timeout).
integration:
  checkout_dir: null     # shared mode; isolated needs "/absolute/integration/checkout"
  status: pending # pending | running | succeeded | failed | not_applicable
  accepted_artifacts: []
  final_artifact: null
  checks: []
resources: []
# Each: type (pane/worktree/server), id_or_path, owner, created_by_team.
# Shared mode records no worktrees; User code checkouts are never resources.
# Lifecycle live state is never persisted; query Herdr fresh.
